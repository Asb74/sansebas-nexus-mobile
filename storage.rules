rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // All mobile note attachments, including audio segments, remain private to
    // their authenticated owner. The desktop client must use Firebase Auth.
    match /users/{userId}/nexus_mobile_notes/{noteId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
